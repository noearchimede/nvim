{
  "line": {
    "prefix": "---",
    "description": "Horizontal line (hyphen) with optional text",
    "body": "- $1 ----------------------------------------------------------------------------\n$0"
  },
  "line (n-dash)": {
    "prefix": "--n",
    "description": "Horizontal line (en dash) with optional text",
    "body": "– $1 ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––\n$0"
  },
  "line (m-dash)": {
    "prefix": "--m",
    "description": "Horizontal line (em dash) with optional text",
    "body": "— $1 ————————————————————————————————————————————————————————————————————————————\n$0"
  },
  "line (#)": {
    "prefix": "###",
    "description": "Horizontal line (hash) with optional text",
    "body": "# $1 ############################################################################\n$0"
  },
  "two lines (hyphen)": {
    "prefix": "---2",
    "description": "Text between two horizontal lines (hyphen)",
    "body": [
      "--------------------------------------------------------------------------------",
      "  $1",
      "--------------------------------------------------------------------------------",
      "$0"
    ]
  },
  "two lines (n-dash)": {
    "prefix": "--n2",
    "description": "Text between two horizontal lines (en dash)",
    "body": [
      "––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––",
      "  $1",
      "––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––",
      "$0"
    ]
  },
  "two lines (m-dash)": {
    "prefix": "--m2",
    "description": "Text between two horizontal lines (em dash)",
    "body": [
      "————————————————————————————————————————————————————————————————————————————————",
      "  $1",
      "————————————————————————————————————————————————————————————————————————————————",
      "$0"
    ]
  },
  "two lines (#)": {
    "prefix": "###2",
    "description": "Text between two horizontal lines (hash)",
    "body": [
      "################################################################################",
      "  $1",
      "################################################################################",
      "$0"
    ]
  },
  "box (unicode)": {
    "prefix": "box",
    "description": "Box around text (unicode)",
    "body": [
      "┌──────────────────────────────────────────────────────────────────────────────┐",
      "│ ${1:                                                                              }│",
      "└──────────────────────────────────────────────────────────────────────────────┘",
      "$0"
    ]
  },
  "box (simple)": {
    "prefix": "boxs",
    "description": "Box around text (ascii)",
    "body": [
      "+------------------------------------------------------------------------------+",
      "| ${1:                                                                              }|",
      "+------------------------------------------------------------------------------+",
      "$0"
    ]
  },
  "box (#)": {
    "prefix": "box#",
    "description": "Box around text (hash)",
    "body": [
      "################################################################################",
      "# ${1:                                                                              }#",
      "################################################################################",
      "$0"
    ]
  }
}
