{
  "paragraph title": {
    "prefix": "partit",
    "description": "Paragraph title",
    "body": "**$1** $0"
  },
  "slide reference": {
    "prefix": "sref",
    "description": "reference to slide",
    "body": "**|Slide $1|** $0",
    "luasnip": {
      "autotrigger": true
    }
  },
  "book reference": {
    "prefix": "bref",
    "description": "reference to book",
    "body": "**|Book $1|** $0"
  },
  "ellipsis": {
    "prefix": "ddd",
    "description": "dot dot dot",
    "body": "[...] $0",
    "luasnip": {
      "autotrigger": true
    }
  },
  "bold ellipsis": {
    "prefix": "DDD",
    "description": "bold dot dot dot",
    "body": "**[...]** $0",
    "luasnip": {
      "autotrigger": true
    }
  },
  "inline code block": {
    "prefix": "kk",
    "description": "inline code block",
    "body": "`$1` $0",
    "luasnip": {
      "autotrigger": true
    }
  }
}
